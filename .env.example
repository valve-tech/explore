DATABASE_URL=postgres://valvetech:valvetech@localhost:5432/valvetech

# Upstream JSON-RPC for both /rpc proxy and internal viem queries.
# In production this should point at the private Valve RPC; locally the
# public endpoint is fine. Format: https://rpc.valve.city/v1/<key>/evm/369
PULSECHAIN_RPC_URL=https://rpc.pulsechain.com

# Debug-enabled node (debug_*/ots_* namespaces). Defaults to PULSECHAIN_RPC_URL
# when unset. Use the private Valve URL here as well in production.
DEBUG_RPC_URL=

BLOCKSCOUT_API_URL=https://api.scan.pulsechain.com/api
PORT=10100

# Portfolio holdings GraphQL gateway (Hasura-style) fronting the
# erc20-balance-changes archive in ClickHouse. Per-chain override
# HOLDINGS_GRAPHQL_URL_<chainId> wins, else this single gateway serves all
# chains. Unset → holdings aren't indexed (the /api/portfolio/holdings route
# degrades to native balance only, indexed:false). The query expects a tracked
# view `erc20_balances(owner, contract, balance)` — see balanceSource.ts.
# HOLDINGS_GRAPHQL_URL=https://holdings.valve.city/v1/graphql
# HOLDINGS_GRAPHQL_URL_369=
# Admin secret sent as the x-hasura-admin-secret header (omit if the gateway is
# open or authenticates at the network edge). Sourced from vault valve_hasura_secret.
# HOLDINGS_GRAPHQL_SECRET=
# GraphQL root field for the current-balances view. Defaults to `current_balances`;
# override if Hasura/GDC tracks it under a chain-namespaced name.
# HOLDINGS_GRAPHQL_ROOT=current_balances

# HMAC secret for SIWE-lite session cookies (workspace sync auth).
# >=32 chars. Generate with: `openssl rand -hex 32`.
# In production this MUST be set or the process throws on startup. Locally
# the API falls back to a per-process random value (sessions invalidate on
# restart) and logs a warning — set this to silence the warning.
SESSION_SECRET=

# Per-IP cap for UNAUTHENTICATED /api requests (per 60s). Defaults to 1200
# (20/s) — moderately high: these are custom, mostly-cached endpoints (not
# RPC passthroughs), so normal dashboard polling (~60/min) never trips it
# while a runaway client still gets caught. Lower it to tighten, or set 0
# to disable. Authenticated requests are limited per their key's own rate.
# API_UNAUTH_RATE_LIMIT=1200
