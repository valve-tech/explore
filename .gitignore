node_modules/
.env
.env.*
!.env.example
dist/
build/
coverage/
*.tsbuildinfo
*.log
data/

# Working-session screenshots + Playwright MCP scratch dir
.playwright-mcp/

# Playwright test runner output (test-results/, HTML report) — regenerated
# per run, never committed. Browser binaries live in the OS cache
# (~/Library/Caches/ms-playwright or equivalent), never in-repo.
test-results/
playwright-report/
blob-report/
# Screenshots taken while verifying a change. Every one of these used to be
# added here by name after it appeared, so the list only ever grew. One rule
# replaces it: the repo tracks NO png at its root (checked — zero tracked png
# files anywhere), and real images belong under docs/ or a package's public/.
# A root-level png is scratch by definition.
/*.png

# Agent worktrees. Git-ignored scratch: `git worktree` owns the real state in
# .git/worktrees, and these are working copies it can recreate.
/.claude/worktrees/
